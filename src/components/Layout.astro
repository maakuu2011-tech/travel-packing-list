---
import "../styles/global.css";
import {
  Luggage,
  Menu,
  X,
  ListChecks,
  BookOpen,
  Info,
} from "@lucide/astro";
import { SITE_URL } from "../../site.config.mjs";

const {
  title = "旅じたくリスト",
  description = "旅行条件に合わせて必要な持ち物を整理できる、無料の旅行持ち物チェックリストです。",
  image = "/images/packing-hero.webp",
  structuredData = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const socialImageUrl = new URL(image, SITE_URL).toString();
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "旅じたくリスト",
  url: SITE_URL,
  description,
};
const structuredDataItems = [websiteStructuredData, ...structuredData];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="旅じたくリスト" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="旅行の荷造りをしているスーツケース" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="theme-color" content="#163b3b" />
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="旅じたくリスト トップ">
          <span class="brand__mark"><Luggage size={24} stroke-width={2.2} /></span>
          <span>
            <span class="brand__name">旅じたくリスト</span>
            <span class="brand__note">忘れ物のない旅へ</span>
          </span>
        </a>
        <button
          class="icon-button menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
          aria-label="メニューを開く"
          data-menu-toggle
        >
          <Menu class="menu-open-icon" size={22} />
          <X class="menu-close-icon" size={22} />
        </button>
        <nav id="main-navigation" class="site-nav" aria-label="メインナビゲーション" data-menu>
          <a href="/"><ListChecks size={18} />リストを作る</a>
          <a href="/guides/"><BookOpen size={18} />持ち物ガイド</a>
          <a href="/about/"><Info size={18} />このサイトについて</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <a class="footer-brand" href="/">旅じたくリスト</a>
          <p>旅行条件に合う持ち物を、出発前に整理。</p>
        </div>
        <nav aria-label="フッターナビゲーション">
          <a href="/guides/">持ち物ガイド</a>
          <a href="/about/">このサイトについて</a>
          <a href="/privacy/">プライバシー</a>
          <a href="/contact/">お問い合わせ</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector("[data-menu-toggle]");
      const menu = document.querySelector("[data-menu]");
      menuButton?.addEventListener("click", () => {
        const expanded = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!expanded));
        menuButton.setAttribute("aria-label", expanded ? "メニューを開く" : "メニューを閉じる");
        menu?.classList.toggle("is-open", !expanded);
      });
    </script>
  </body>
</html>
